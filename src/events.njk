---
layout: layouts/base.njk
title: Events
---
<section class="page-simple page-wide">
  <h1>Events</h1>

  <h2>Upcoming</h2>
  <div class="event-list">
    {% for e in events.upcoming %}
    <article class="event-card">
      <h3>{{ e.name }}</h3>
      <p class="event-meta">{{ e.when }} · {{ e.where }}</p>
      {% if e.note %}<p class="event-note">{{ e.note }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>

  <h2>Past Events</h2>
  <div class="event-list">
    {% for e in events.past %}
    <article class="event-card event-card-past">
      <h3>{{ e.name }}</h3>
      <p class="event-meta">{{ e.when }} · {{ e.where }}</p>
      {% if e.note %}<p class="event-note">{{ e.note }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>
</section>
