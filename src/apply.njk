<style>
  .payment-box { background: #FBF8FC; border: 1px solid #DDD0E2; padding: 1.25rem 1.5rem; margin: 1.5rem 0; }
  .payment-box h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  .payment-box h3 { font-size: 0.95rem; margin: 1rem 0 0.25rem; }
  .payment-box p { margin: 0.2rem 0; }
  .payment-box .payment-note { margin-top: 1rem; font-size: 0.9rem; color: #5B4F63; }
  .photo-help { margin: .35rem 0 1rem; color: #6b6170; font-size: .88rem; }
  .photo-crop-result img { display: block; width: 5rem; aspect-ratio: 4 / 5; object-fit: cover; border: 2px solid #C9A66B; border-radius: 4px; margin: .5rem 0 1rem; }
  .photo-crop-modal[hidden] { display: none; }
  .photo-crop-modal { position: fixed; inset: 0; z-index: 1000; display: grid; place-items: center; padding: 1rem; background: rgba(20, 12, 25, .78); }
  .photo-crop-dialog { width: min(100%, 28rem); max-height: 95vh; overflow-y: auto; background: #FBF8FC; color: #331648; padding: 1.4rem; border-radius: 12px; box-shadow: 0 12px 40px rgba(0,0,0,.3); }
  .photo-crop-dialog h2 { margin-top: 0; }
  .photo-crop-frame { width: min(100%, 20rem); aspect-ratio: 4 / 5; margin: 1rem auto; overflow: hidden; background: #21152a; touch-action: none; }
  #photo-crop-canvas { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
  #photo-crop-canvas:active { cursor: grabbing; }
  .photo-crop-actions { display: flex; justify-content: flex-end; gap: .75rem; margin-top: 1.25rem; }
  .photo-crop-error { color: #a32626; min-height: 1.2em; }
  @media (max-width: 480px) { .photo-crop-dialog { padding: 1rem; } .photo-crop-actions button { flex: 1; } }
</style>

