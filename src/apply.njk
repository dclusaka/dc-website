---
layout: layouts/base.njk
title: Apply
---
<section class="page-simple">
  <h1>Become a Member</h1>
  <p>Regular Annual Membership:</p>
  <p>ZMW 750 for Heads of Missions / Honorary Consuls / Holders of a Diplomatic ID<br>
  ZMW 1000 for Family (includes Spouse/Partner)</p>

  <form class="app-form" id="apply-form">
    <label for="surname">Surname</label>
    <input type="text" id="surname" name="surname" required>

    <label for="first_name">First Name</label>
    <input type="text" id="first_name" name="first_name" required>

    <label for="diplomatic_mission">Diplomatic Mission</label>
    <select id="diplomatic_mission" name="diplomatic_mission" required>
      <option value="" disabled selected>Choose a mission…</option>
      <option>Embassy of Algeria</option>
      <option>Embassy of Angola</option>
      <option>High Commission of Botswana</option>
      <option>Embassy of Brazil</option>
      <option>Embassy of Burundi</option>
      <option>High Commission of Canada</option>
      <option>Embassy of China</option>
      <option>Embassy of Cuba</option>
      <option>Embassy of the Democratic Republic of the Congo</option>
      <option>Embassy of Czechia</option>
      <option>Embassy of Egypt</option>
      <option>Embassy of Finland</option>
      <option>Embassy of France</option>
      <option>Embassy of Germany</option>
      <option>High Commission of Ghana</option>
      <option>Apostolic Nunciature (Holy See)</option>
      <option>High Commission of India</option>
      <option>Embassy of Ireland</option>
      <option>Embassy of Israel</option>
      <option>Embassy of Italy</option>
      <option>Embassy of Japan</option>
      <option>High Commission of Kenya</option>
      <option>Embassy of Libya</option>
      <option>High Commission of Malawi</option>
      <option>Embassy of Morocco</option>
      <option>High Commission of Mozambique</option>
      <option>Embassy of Namibia</option>
      <option>High Commission of Nigeria</option>
      <option>Embassy of Palestine</option>
      <option>Embassy of Russia</option>
      <option>High Commission of Rwanda</option>
      <option>Embassy of Saudi Arabia</option>
      <option>Embassy of Serbia</option>
      <option>Embassy of Somalia</option>
      <option>High Commission of South Africa</option>
      <option>Embassy of Sudan</option>
      <option>Embassy of Sweden</option>
      <option>High Commission of Tanzania</option>
      <option>Embassy of Turkey</option>
      <option>High Commission of the United Kingdom</option>
      <option>Embassy of the United States</option>
      <option>High Commission of Zimbabwe</option>
      <option>---------------------</option>
      <option>African Union</option>
      <option>COMESA</option>
      <option>European Union</option>
      <option>IMF</option>
      <option>United Nations</option>
      <option>World Bank</option>
      <option value="other">Other (not listed)</option>
    </select>

    <div id="mission-other-field" style="display:none;">
      <label for="diplomatic_mission_other">Please specify</label>
      <input type="text" id="diplomatic_mission_other" name="diplomatic_mission_other">
    </div>

    <label for="diplomatic_title">Diplomatic Title</label>
    <input type="text" id="diplomatic_title" name="diplomatic_title" required>

    <label for="phone">Contact Number</label>
    <input type="tel" id="phone" name="phone" required>

    <label for="email">Email Address</label>
    <input type="email" id="email" name="email" required>

    <label for="photo">Submit your headshot photo</label>
    <input type="file" id="photo" name="photo" accept="image/*" required>

    <fieldset class="radio-group">
      <legend>Would you like to apply for your spouse too?</legend>
      <label class="radio-label"><input type="radio" name="has_spouse" value="no" checked> No</label>
      <label class="radio-label"><input type="radio" name="has_spouse" value="yes"> Yes</label>
    </fieldset>

    <div id="spouse-fields" style="display:none;">
      <h2>Spouse Details</h2>

      <label for="spouse_surname">Spouse Surname</label>
      <input type="text" id="spouse_surname" name="spouse_surname">

      <label for="spouse_first_name">Spouse First Name</label>
      <input type="text" id="spouse_first_name" name="spouse_first_name">

      <label for="spouse_phone">Spouse Contact Number</label>
      <input type="tel" id="spouse_phone" name="spouse_phone">

      <label for="spouse_email">Spouse Email Address</label>
      <input type="email" id="spouse_email" name="spouse_email">

      <label for="spouse_photo">Spouse Headshot Photo</label>
      <input type="file" id="spouse_photo" name="spouse_photo" accept="image/*">
    </div>

    <button type="submit" id="apply-submit">Submit Application</button>
  </form>

  <p class="form-status" id="apply-status"></p>
</section>

<script>
  const missionSelect = document.getElementById('diplomatic_mission');
  const missionOtherField = document.getElementById('mission-other-field');
  const missionOtherInput = document.getElementById('diplomatic_mission_other');

  missionSelect.addEventListener('change', () => {
    const isOther = missionSelect.value === 'other';
    missionOtherField.style.display = isOther ? 'flex' : 'none';
    missionOtherInput.required = isOther;
  });

  function getMissionValue() {
    return missionSelect.value === 'other' ? missionOtherInput.value.trim() : missionSelect.value;
  }

  const spouseRadios = document.querySelectorAll('input[name="has_spouse"]');
  const spouseFields = document.getElementById('spouse-fields');
  const spouseInputs = spouseFields.querySelectorAll('input');

  function getHasSpouseValue() {
    return document.querySelector('input[name="has_spouse"]:checked').value;
  }

  spouseRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      const showSpouse = getHasSpouseValue() === 'yes';
      spouseFields.style.display = showSpouse ? 'flex' : 'none';
      spouseInputs.forEach(input => {
        if (input.type !== 'file') input.required = showSpouse;
      });
    });
  });

  async function uploadPhoto(file) {
    const ext = file.name.split('.').pop();
    const path = `${crypto.randomUUID()}.${ext}`;
    const { error } = await sb.storage.from('member-photos').upload(path, file);
    if (error) throw error;
    const { data } = sb.storage.from('member-photos').getPublicUrl(path);
    return data.publicUrl;
  }

  const form = document.getElementById('apply-form');
  const statusEl = document.getElementById('apply-status');
  const submitBtn = document.getElementById('apply-submit');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    statusEl.className = 'form-status';
    statusEl.textContent = 'Submitting…';

    const val = id => document.getElementById(id).value.trim();

    try {
      const photo_url = await uploadPhoto(document.getElementById('photo').files[0]);

      const { data: inserted, error: insertError } = await sb.from('members').insert({
        surname: val('surname'),
        first_name: val('first_name'),
        diplomatic_mission: getMissionValue(),
        diplomatic_title: val('diplomatic_title'),
        phone: val('phone'),
        email: val('email'),
        photo_url,
        status: 'pending',
      }).select().single();

      if (insertError) throw insertError;

      if (getHasSpouseValue() === 'yes') {
        const spousePhotoFile = document.getElementById('spouse_photo').files[0];
        const spouse_photo_url = spousePhotoFile ? await uploadPhoto(spousePhotoFile) : null;

        const { error: spouseError } = await sb.from('members').insert({
          surname: val('spouse_surname'),
          first_name: val('spouse_first_name'),
          phone: val('spouse_phone'),
          email: val('spouse_email'),
          photo_url: spouse_photo_url,
          status: 'pending',
          spouse_of: inserted.id,
        });

        if (spouseError) throw spouseError;
      }

      statusEl.className = 'form-status success';
      statusEl.textContent = "Thank you! Your application has been received. We'll be in touch about payment and next steps shortly.";
      form.reset();
      spouseFields.style.display = 'none';
      missionOtherField.style.display = 'none';
    } catch (err) {
      statusEl.className = 'form-status error';
      statusEl.textContent = 'Something went wrong: ' + err.message;
      submitBtn.disabled = false;
    }
  });
</script>
