---
layout: layouts/base.njk
title: Admin
---
<style>
  section.admin-wide { max-width: none; margin: 0; }
  .admin-wide .member-table { table-layout: auto; }
  .admin-wide .member-table th,
  .admin-wide .member-table td { vertical-align: top; padding: 0.75rem 1rem; }
  #admin-gate .member-table td:nth-child(1) { min-width: 13rem; }
  #admin-gate .member-table td:nth-child(2) { min-width: 8rem; }
  #admin-gate .member-table td:nth-child(4) { overflow-wrap: anywhere; }
  #admin-gate .member-table td:nth-child(5) { white-space: nowrap; }
  #admin-gate .member-table td:nth-child(7) { white-space: nowrap; }
  #admin-sponsors-list .member-table th:first-child,
  #admin-sponsors-list .member-table td:first-child { width: 5rem; }
  .member-edit-btn { margin-top: 0.4rem; cursor: pointer; }
</style>
<div id="logout-bar" style="display:none;text-align:right;padding:1rem clamp(1.25rem, 4vw, 3rem) 0;">
  <button type="button" id="logout-btn" style="cursor:pointer;font-family:inherit;font-size:0.9rem;padding:0.5rem 1.1rem;background:none;color:#331648;border:1px solid #331648;">Log out</button>
</div>
<section class="page-simple page-wide admin-wide">
  <h1>Admin — All Members</h1>
  <input type="text" id="member-search" placeholder="Search by name, mission, title, email, phone…" class="admin-search-box" style="display:none;">
  <div id="admin-gate">
    <p>Checking your login…</p>
  </div>
</section>

<section class="page-simple page-wide admin-wide" id="admin-member-edit-section" style="display:none;">
  <h1>Edit Member</h1>

  <form class="app-form" id="member-form">
    <input type="hidden" id="member_id" value="">

    <label for="member_surname">Surname</label>
    <input type="text" id="member_surname" required>

    <label for="member_first_name">First Name</label>
    <input type="text" id="member_first_name" required>

    <label for="member_mission">Diplomatic Mission</label>
    <input type="text" id="member_mission">

    <label for="member_title">Diplomatic Title</label>
    <input type="text" id="member_title">

    <label for="member_phone">Phone</label>
    <input type="tel" id="member_phone">

    <label for="member_email">Email</label>
    <input type="email" id="member_email">

    <label for="member_status">Status</label>
    <select id="member_status">
      <option value="pending">Pending</option>
      <option value="active">Active</option>
      <option value="expired">Expired</option>
    </select>

    <label for="member_started">Membership Started</label>
    <input type="date" id="member_started">

    <label for="member_expires">Membership Expires</label>
    <input type="date" id="member_expires">

    <label for="member_photo">Photo (leave blank to keep the current one)</label>
    <input type="file" id="member_photo" accept="image/*">

    <button type="submit" id="member-submit">Save Changes</button>
    <button type="button" id="member-cancel-edit">Cancel</button>
  </form>

  <p class="form-status" id="member-edit-status"></p>
</section>

<section class="page-simple page-wide admin-wide" id="admin-events-section" style="display:none;">
  <h1>Manage Events</h1>

  <form class="app-form" id="event-form">
    <input type="hidden" id="event_id" value="">
    <label for="event_title">Title</label>
    <input type="text" id="event_title" required>

    <label for="event_date">Date (leave blank for "TBD")</label>
    <input type="date" id="event_date">

    <label for="event_time_label">Time (e.g. "5:30 pm – 7:30 pm")</label>
    <input type="text" id="event_time_label">

    <label for="event_location">Location</label>
    <input type="text" id="event_location">

    <label for="event_description">Description</label>
    <textarea id="event_description" rows="4"></textarea>

    <button type="submit" id="event-submit">Add Event</button>
    <button type="button" id="event-cancel-edit" style="display:none;">Cancel Edit</button>
  </form>

  <p class="form-status" id="event-status"></p>

  <div id="admin-events-list"></div>
</section>

<section class="page-simple page-wide admin-wide" id="admin-charity-section" style="display:none;">
  <h1>Manage Charity Projects</h1>
  <form class="app-form" id="charity-form">
    <input type="hidden" id="charity_id" value="">
    <label for="charity_title">Project title</label>
    <input type="text" id="charity_title" required>
    <label for="charity_beneficiary">Beneficiary / organisation</label>
    <input type="text" id="charity_beneficiary">
    <label for="charity_description">Description</label>
    <textarea id="charity_description" rows="5"></textarea>
    <label for="charity_order">Display order (lower shows first)</label>
    <input type="number" id="charity_order" value="1" min="0">
    <label class="admin-checkbox-label"><input type="checkbox" id="charity_published" checked> Visible on the public website</label>
    <button type="submit" id="charity-submit">Add Charity Project</button>
    <button type="button" id="charity-cancel-edit" style="display:none;">Cancel Edit</button>
  </form>
  <p class="form-status" id="charity-status"></p>
  <div id="admin-charity-list"></div>
</section>

<section class="page-simple page-wide admin-wide" id="admin-sponsors-section" style="display:none;">
  <h1>Manage Sponsors</h1>

  <form class="app-form" id="sponsor-form">
    <input type="hidden" id="sponsor_id" value="">
    <input type="hidden" id="sponsor_existing_logo" value="">

    <label for="sponsor_name">Name</label>
    <input type="text" id="sponsor_name" required>

    <label for="sponsor_logo">Logo (leave blank to keep existing when editing)</label>
    <input type="file" id="sponsor_logo" accept="image/*">

    <label for="sponsor_details">Benefit details (one per line)</label>
    <textarea id="sponsor_details" rows="4"></textarea>

    <label for="sponsor_notes">Notes (optional)</label>
    <input type="text" id="sponsor_notes">

    <label for="sponsor_website">Website (optional)</label>
    <input type="text" id="sponsor_website">

    <label for="sponsor_order">Display order (lower shows first)</label>
    <input type="number" id="sponsor_order" value="1" min="1">

    <button type="submit" id="sponsor-submit">Add Sponsor</button>
    <button type="button" id="sponsor-cancel-edit" style="display:none;">Cancel Edit</button>
  </form>

  <p class="form-status" id="sponsor-status"></p>

  <div id="admin-sponsors-list"></div>
</section>

<script>
  const STATUS_OPTIONS = ['pending', 'active', 'expired'];
  let allMembers = [];

  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderMemberRows(list) {
    return list.map(m => `
      <tr data-id="${esc(m.id)}">
        <td>
          ${esc(m.first_name)} ${esc(m.surname)}${m.spouse_of ? ' <span class="spouse-tag">(spouse)</span>' : ''}
          <br><button type="button" class="member-edit-btn">Edit</button>
        </td>
        <td>${esc(m.diplomatic_mission)}</td>
        <td>${esc(m.diplomatic_title)}</td>
        <td>${esc(m.email)}</td>
        <td>${esc(m.phone)}</td>
        <td>
          <select class="status-select">
            ${STATUS_OPTIONS.map(s => `<option value="${s}" ${s === m.status ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`).join('')}
          </select>
        </td>
        <td>${esc(m.membership_expires) || '—'}</td>
      </tr>
    `).join('');
  }

  function renderMemberTable(list) {
    const gate = document.getElementById('admin-gate');
    gate.innerHTML = `
      <table class="member-table">
        <thead>
          <tr><th>Name</th><th>Mission</th><th>Title</th><th>Email</th><th>Phone</th><th>Status</th><th>Expires</th></tr>
        </thead>
        <tbody>${renderMemberRows(list)}</tbody>
      </table>
    `;

    document.querySelectorAll('.status-select').forEach(select => {
      select.addEventListener('change', async (e) => {
        const row = e.target.closest('tr');
        const id = row.dataset.id;
        const newStatus = e.target.value;
        const update = { status: newStatus };

        if (newStatus === 'active') {
          const today = new Date();
          const expires = new Date(today);
          expires.setFullYear(expires.getFullYear() + 1);
          update.membership_started = today.toISOString().slice(0, 10);
          update.membership_expires = expires.toISOString().slice(0, 10);
        }

        const { error } = await sb.from('members').update(update).eq('id', id);
        if (error) {
          alert('Could not update status: ' + error.message);
        } else {
          loadAdminTable();
        }
      });
    });

    document.querySelectorAll('.member-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.closest('tr').dataset.id;
        const m = allMembers.find(x => x.id === id);
        openMemberEditForm(m);
      });
    });
  }

  function filterMembers(query) {
    const q = query.trim().toLowerCase();
    if (!q) return allMembers;
    return allMembers.filter(m => {
      const haystack = [
        m.first_name, m.surname, m.diplomatic_mission, m.diplomatic_title,
        m.email, m.phone, m.status
      ].filter(Boolean).join(' ').toLowerCase();
      return haystack.includes(q);
    });
  }

  document.getElementById('member-search').addEventListener('input', (e) => {
    renderMemberTable(filterMembers(e.target.value));
  });

  async function loadAdminTable() {
    const gate = document.getElementById('admin-gate');
    const { data, error } = await sb
      .from('members')
      .select('id, surname, first_name, diplomatic_mission, diplomatic_title, email, phone, status, membership_started, membership_expires, spouse_of')
      .order('diplomatic_mission', { ascending: true, nullsFirst: false })
      .order('surname', { ascending: true });

    if (error) {
      gate.innerHTML = '<p class="form-status error">Could not load members: ' + error.message + '</p>';
      return;
    }

    allMembers = data;
    const searchBox = document.getElementById('member-search');
    renderMemberTable(filterMembers(searchBox.value));
  }

  // ---- Member editing ----
  const memberEditSection = document.getElementById('admin-member-edit-section');
  const memberForm = document.getElementById('member-form');
  const memberIdField = document.getElementById('member_id');
  const memberEditStatusEl = document.getElementById('member-edit-status');
  const memberCancelBtn = document.getElementById('member-cancel-edit');

  function openMemberEditForm(m) {
    memberIdField.value = m.id;
    document.getElementById('member_surname').value = m.surname || '';
    document.getElementById('member_first_name').value = m.first_name || '';
    document.getElementById('member_mission').value = m.diplomatic_mission || '';
    document.getElementById('member_title').value = m.diplomatic_title || '';
    document.getElementById('member_phone').value = m.phone || '';
    document.getElementById('member_email').value = m.email || '';
    document.getElementById('member_status').value = m.status || 'pending';
    document.getElementById('member_started').value = m.membership_started || '';
    document.getElementById('member_expires').value = m.membership_expires || '';
    memberEditStatusEl.textContent = '';
    memberEditSection.style.display = 'block';
    window.scrollTo({ top: memberEditSection.offsetTop - 20, behavior: 'smooth' });
  }

  function closeMemberEditForm() {
    memberForm.reset();
    memberIdField.value = '';
    memberEditSection.style.display = 'none';
  }

  memberCancelBtn.addEventListener('click', closeMemberEditForm);

  memberForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    memberEditStatusEl.className = 'form-status';
    memberEditStatusEl.textContent = 'Saving…';

    const payload = {
      surname: document.getElementById('member_surname').value.trim(),
      first_name: document.getElementById('member_first_name').value.trim(),
      diplomatic_mission: document.getElementById('member_mission').value.trim() || null,
      diplomatic_title: document.getElementById('member_title').value.trim() || null,
      phone: document.getElementById('member_phone').value.trim() || null,
      email: document.getElementById('member_email').value.trim() || null,
      status: document.getElementById('member_status').value,
      membership_started: document.getElementById('member_started').value || null,
      membership_expires: document.getElementById('member_expires').value || null,
    };

    const id = memberIdField.value;

    try {
      const photoFile = document.getElementById('member_photo').files[0];
      if (photoFile) {
        const resized = await resizeImageFile(photoFile, 800, 0.82);
        const path = `${crypto.randomUUID()}.jpg`;
        const { error: uploadError } = await sb.storage.from('member-photos').upload(path, resized, { contentType: 'image/jpeg' });
        if (uploadError) throw uploadError;
        payload.photo_url = sb.storage.from('member-photos').getPublicUrl(path).data.publicUrl;
      }
    } catch (uploadErr) {
      memberEditStatusEl.className = 'form-status error';
      memberEditStatusEl.textContent = 'Photo upload failed: ' + uploadErr.message;
      return;
    }

    const { error } = await sb.from('members').update(payload).eq('id', id);

    if (error) {
      memberEditStatusEl.className = 'form-status error';
      memberEditStatusEl.textContent = 'Something went wrong: ' + error.message;
    } else {
      memberEditStatusEl.className = 'form-status success';
      memberEditStatusEl.textContent = 'Member updated.';
      closeMemberEditForm();
      loadAdminTable();
    }
  });

  // ---- Event management, charity links and photo galleries ----
  const eventForm = document.getElementById('event-form');
  const eventIdField = document.getElementById('event_id');
  const eventSubmitBtn = document.getElementById('event-submit');
  const eventCancelBtn = document.getElementById('event-cancel-edit');
  const eventStatusEl = document.getElementById('event-status');
  const eventsListEl = document.getElementById('admin-events-list');

  function resetEventForm() {
    eventForm.reset();
    eventIdField.value = '';
    eventSubmitBtn.textContent = 'Add Event';
    eventCancelBtn.style.display = 'none';
  }
  eventCancelBtn.addEventListener('click', resetEventForm);

  async function loadEventsAdminList() {
    const [eventsResult, projectsResult, photosResult, linksResult] = await Promise.all([
      sb.from('events').select('id, title, event_date, time_label, location, description').order('event_date', { ascending: false, nullsFirst: true }),
      sb.from('charity_projects').select('id, title').order('title', { ascending: true }),
      sb.from('event_photos').select('id, event_id, storage_path, caption, display_order').order('display_order', { ascending: true }),
      sb.from('event_charity_projects').select('event_id, charity_project_id')
    ]);
    if (eventsResult.error || projectsResult.error || photosResult.error || linksResult.error) {
      const err = eventsResult.error || projectsResult.error || photosResult.error || linksResult.error;
      eventsListEl.innerHTML = `<p class="form-status error">Could not load event management data: ${esc(err.message)}</p>`;
      return;
    }

    const projects = projectsResult.data || [];
    const photosByEvent = new Map();
    (photosResult.data || []).forEach(photo => {
      const list = photosByEvent.get(photo.event_id) || [];
      list.push(photo);
      photosByEvent.set(photo.event_id, list);
    });
    const linksByEvent = new Map();
    (linksResult.data || []).forEach(link => {
      const list = linksByEvent.get(link.event_id) || [];
      list.push(link.charity_project_id);
      linksByEvent.set(link.event_id, list);
    });

    eventsListEl.innerHTML = (eventsResult.data || []).map(event => {
      const selectedProjects = linksByEvent.get(event.id) || [];
      const projectOptions = projects.length
        ? projects.map(project => `<label class="admin-inline-check"><input type="checkbox" class="event-project-check" value="${esc(project.id)}" ${selectedProjects.includes(project.id) ? 'checked' : ''}> ${esc(project.title)}</label>`).join('')
        : '<p class="admin-muted">Add a charity project below before linking one to this event.</p>';
      const photos = photosByEvent.get(event.id) || [];
      const photoItems = photos.length ? photos.map(photo => {
        const url = sb.storage.from('event-photos').getPublicUrl(photo.storage_path).data.publicUrl;
        return `<figure class="admin-event-photo" data-photo-id="${esc(photo.id)}">
          <img src="${esc(url)}" alt="${esc(photo.caption || event.title)}" loading="lazy">
          <figcaption>${esc(photo.caption || 'No caption')}</figcaption>
          <input type="text" class="event-photo-caption-edit" value="${esc(photo.caption || '')}" maxlength="200" aria-label="Photo caption">
          <button type="button" class="event-photo-caption-save-btn">Save caption</button>
          <button type="button" class="event-photo-delete-btn">Delete photo</button>
        </figure>`;
      }).join('') : '<p class="admin-muted">No photos uploaded for this event yet.</p>';
      return `<article class="admin-event-card" data-event-id="${esc(event.id)}">
        <div class="admin-event-heading"><div><h3>${esc(event.title)}</h3><p class="admin-muted">${esc(event.event_date || 'Date TBD')} · ${esc(event.location || 'Location not set')}</p></div>
          <div class="admin-event-actions"><button type="button" class="event-edit-btn">Edit event</button><button type="button" class="event-delete-btn">Delete event</button></div>
        </div>
        <div class="admin-event-projects"><strong>Linked charity projects</strong><div class="admin-project-checkboxes">${projectOptions}</div><button type="button" class="event-project-save-btn">Save project links</button></div>
        <div class="admin-event-gallery"><strong>Event photo gallery</strong><div class="admin-event-photo-grid">${photoItems}</div>
          <label>Upload photos (multiple files allowed)<input type="file" class="event-photo-files" accept="image/jpeg,image/png,image/webp" multiple></label>
          <label>Caption for these photos (optional)<input type="text" class="event-photo-caption" maxlength="200"></label>
          <button type="button" class="event-photo-upload-btn">Upload photos</button>
          <p class="form-status event-photo-status"></p>
        </div>
      </article>`;
    }).join('') || '<p>No events have been added yet.</p>';

    eventsListEl.querySelectorAll('.event-edit-btn').forEach(button => button.addEventListener('click', () => {
      const card = button.closest('[data-event-id]');
      const event = eventsResult.data.find(item => item.id === card.dataset.eventId);
      eventIdField.value = event.id;
      document.getElementById('event_title').value = event.title || '';
      document.getElementById('event_date').value = event.event_date || '';
      document.getElementById('event_time_label').value = event.time_label || '';
      document.getElementById('event_location').value = event.location || '';
      document.getElementById('event_description').value = event.description || '';
      eventSubmitBtn.textContent = 'Save Changes';
      eventCancelBtn.style.display = 'inline-block';
      window.scrollTo({ top: eventForm.offsetTop - 20, behavior: 'smooth' });
    }));

    eventsListEl.querySelectorAll('.event-delete-btn').forEach(button => button.addEventListener('click', async () => {
      const card = button.closest('[data-event-id]');
      if (!confirm('Delete this event? Its linked photos and charity links will also be removed.')) return;
      const { error } = await sb.from('events').delete().eq('id', card.dataset.eventId);
      if (error) alert('Could not delete event: ' + error.message);
      else loadEventsAdminList();
    }));

    eventsListEl.querySelectorAll('.event-project-save-btn').forEach(button => button.addEventListener('click', async () => {
      const card = button.closest('[data-event-id]');
      const eventId = card.dataset.eventId;
      const selected = [...card.querySelectorAll('.event-project-check:checked')].map(input => input.value);
      button.disabled = true;
      try {
        const { error: deleteError } = await sb.from('event_charity_projects').delete().eq('event_id', eventId);
        if (deleteError) throw deleteError;
        if (selected.length) {
          const rows = selected.map(projectId => ({ event_id: eventId, charity_project_id: projectId }));
          const { error: insertError } = await sb.from('event_charity_projects').insert(rows);
          if (insertError) throw insertError;
        }
        button.textContent = 'Saved';
      } catch (error) {
        alert('Could not save charity links: ' + error.message);
      } finally {
        button.disabled = false;
      }
    }));

    eventsListEl.querySelectorAll('.event-photo-upload-btn').forEach(button => button.addEventListener('click', async () => {
      const card = button.closest('[data-event-id]');
      const filesInput = card.querySelector('.event-photo-files');
      const files = [...(filesInput.files || [])];
      const status = card.querySelector('.event-photo-status');
      if (!files.length) { status.textContent = 'Choose at least one image first.'; return; }
      if (files.some(file => !['image/jpeg', 'image/png', 'image/webp'].includes(file.type))) { status.textContent = 'Use JPEG, PNG or WebP images only.'; return; }
      button.disabled = true;
      status.className = 'form-status event-photo-status';
      status.textContent = 'Uploading…';
      const caption = card.querySelector('.event-photo-caption').value.trim() || null;
      try {
        for (const file of files) {
          const resized = await resizeImageFile(file, 1600, 0.78, 'image/jpeg');
          const path = `${card.dataset.eventId}/${crypto.randomUUID()}.jpg`;
          const { error: uploadError } = await sb.storage.from('event-photos').upload(path, resized, { contentType: 'image/jpeg', upsert: false });
          if (uploadError) throw uploadError;
          const { error: rowError } = await sb.from('event_photos').insert({ event_id: card.dataset.eventId, storage_path: path, caption });
          if (rowError) {
            await sb.storage.from('event-photos').remove([path]);
            throw rowError;
          }
        }
        status.className = 'form-status success event-photo-status';
        status.textContent = `${files.length} photo${files.length === 1 ? '' : 's'} uploaded.`;
        filesInput.value = '';
        card.querySelector('.event-photo-caption').value = '';
        loadEventsAdminList();
      } catch (error) {
        status.className = 'form-status error event-photo-status';
        status.textContent = 'Upload failed: ' + error.message;
      } finally {
        button.disabled = false;
      }
    }));

    eventsListEl.querySelectorAll('.event-photo-caption-save-btn').forEach(button => button.addEventListener('click', async () => {
      const figure = button.closest('[data-photo-id]');
      const card = button.closest('[data-event-id]');
      const photo = (photosByEvent.get(card.dataset.eventId) || []).find(item => item.id === figure.dataset.photoId);
      const caption = figure.querySelector('.event-photo-caption-edit').value.trim() || null;
      button.disabled = true;
      const { error } = await sb.from('event_photos').update({ caption }).eq('id', photo.id);
      if (error) alert('Could not update caption: ' + error.message);
      else loadEventsAdminList();
      button.disabled = false;
    }));

    eventsListEl.querySelectorAll('.event-photo-delete-btn').forEach(button => button.addEventListener('click', async () => {
      const figure = button.closest('[data-photo-id]');
      const card = button.closest('[data-event-id]');
      const photo = (photosByEvent.get(card.dataset.eventId) || []).find(item => item.id === figure.dataset.photoId);
      if (!confirm('Delete this event photo?')) return;
      const { error: rowError } = await sb.from('event_photos').delete().eq('id', photo.id);
      if (rowError) { alert('Could not delete photo record: ' + rowError.message); return; }
      const { error: storageError } = await sb.storage.from('event-photos').remove([photo.storage_path]);
      if (storageError) alert('The photo record was deleted, but the stored file could not be removed: ' + storageError.message);
      loadEventsAdminList();
    }));
  }

  eventForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    eventStatusEl.className = 'form-status';
    eventStatusEl.textContent = 'Saving…';
    const payload = {
      title: document.getElementById('event_title').value.trim(),
      event_date: document.getElementById('event_date').value || null,
      time_label: document.getElementById('event_time_label').value.trim() || null,
      location: document.getElementById('event_location').value.trim() || null,
      description: document.getElementById('event_description').value.trim() || null,
    };
    const id = eventIdField.value;
    const { error } = id ? await sb.from('events').update(payload).eq('id', id) : await sb.from('events').insert(payload);
    if (error) {
      eventStatusEl.className = 'form-status error';
      eventStatusEl.textContent = 'Something went wrong: ' + error.message;
    } else {
      eventStatusEl.className = 'form-status success';
      eventStatusEl.textContent = id ? 'Event updated.' : 'Event added.';
      resetEventForm();
      loadEventsAdminList();
    }
  });

  // ---- Charity project management ----
  const charityForm = document.getElementById('charity-form');
  const charityIdField = document.getElementById('charity_id');
  const charitySubmitBtn = document.getElementById('charity-submit');
  const charityCancelBtn = document.getElementById('charity-cancel-edit');
  const charityStatusEl = document.getElementById('charity-status');
  const charityListEl = document.getElementById('admin-charity-list');

  function resetCharityForm() {
    charityForm.reset();
    charityIdField.value = '';
    document.getElementById('charity_order').value = 1;
    document.getElementById('charity_published').checked = true;
    charitySubmitBtn.textContent = 'Add Charity Project';
    charityCancelBtn.style.display = 'none';
  }
  charityCancelBtn.addEventListener('click', resetCharityForm);

  async function loadCharityAdminList() {
    const { data, error } = await sb.from('charity_projects').select('id, title, beneficiary, description, is_published, display_order').order('display_order', { ascending: true });
    if (error) { charityListEl.innerHTML = `<p class="form-status error">Could not load charity projects: ${esc(error.message)}</p>`; return; }
    charityListEl.innerHTML = `<div class="admin-charity-list">${(data || []).map(project => `<article class="admin-charity-row" data-project-id="${esc(project.id)}">
      <div><strong>${esc(project.title)}</strong><p class="admin-muted">${esc(project.beneficiary || 'No beneficiary specified')} · ${project.is_published ? 'Published' : 'Hidden'}</p></div>
      <div><button type="button" class="charity-edit-btn">Edit</button> <button type="button" class="charity-delete-btn">Delete</button></div>
    </article>`).join('') || '<p>No charity projects have been added yet.</p>'}</div>`;
    charityListEl.querySelectorAll('.charity-edit-btn').forEach(button => button.addEventListener('click', () => {
      const project = data.find(item => item.id === button.closest('[data-project-id]').dataset.projectId);
      charityIdField.value = project.id;
      document.getElementById('charity_title').value = project.title || '';
      document.getElementById('charity_beneficiary').value = project.beneficiary || '';
      document.getElementById('charity_description').value = project.description || '';
      document.getElementById('charity_order').value = project.display_order ?? 0;
      document.getElementById('charity_published').checked = project.is_published;
      charitySubmitBtn.textContent = 'Save Changes';
      charityCancelBtn.style.display = 'inline-block';
      window.scrollTo({ top: charityForm.offsetTop - 20, behavior: 'smooth' });
    }));
    charityListEl.querySelectorAll('.charity-delete-btn').forEach(button => button.addEventListener('click', async () => {
      const id = button.closest('[data-project-id]').dataset.projectId;
      if (!confirm('Delete this charity project? Its event links will also be removed.')) return;
      const { error } = await sb.from('charity_projects').delete().eq('id', id);
      if (error) alert('Could not delete project: ' + error.message);
      else { loadCharityAdminList(); loadEventsAdminList(); }
    }));
  }

  charityForm.addEventListener('submit', async event => {
    event.preventDefault();
    charitySubmitBtn.disabled = true;
    charityStatusEl.className = 'form-status';
    charityStatusEl.textContent = 'Saving…';
    const payload = {
      title: document.getElementById('charity_title').value.trim(),
      beneficiary: document.getElementById('charity_beneficiary').value.trim() || null,
      description: document.getElementById('charity_description').value.trim() || null,
      display_order: parseInt(document.getElementById('charity_order').value, 10) || 0,
      is_published: document.getElementById('charity_published').checked
    };
    const id = charityIdField.value;
    const { error } = id ? await sb.from('charity_projects').update(payload).eq('id', id) : await sb.from('charity_projects').insert(payload);
    if (error) {
      charityStatusEl.className = 'form-status error';
      charityStatusEl.textContent = 'Could not save project: ' + error.message;
    } else {
      charityStatusEl.className = 'form-status success';
      charityStatusEl.textContent = id ? 'Charity project updated.' : 'Charity project added.';
      resetCharityForm();
      loadCharityAdminList();
      loadEventsAdminList();
    }
    charitySubmitBtn.disabled = false;
  });

  // ---- Sponsor management ----
  const sponsorForm = document.getElementById('sponsor-form');
  const sponsorIdField = document.getElementById('sponsor_id');
  const sponsorExistingLogoField = document.getElementById('sponsor_existing_logo');
  const sponsorSubmitBtn = document.getElementById('sponsor-submit');
  const sponsorCancelBtn = document.getElementById('sponsor-cancel-edit');
  const sponsorStatusEl = document.getElementById('sponsor-status');
  const sponsorsListEl = document.getElementById('admin-sponsors-list');

  let nextSponsorOrder = 1;

  function resetSponsorForm() {
    sponsorForm.reset();
    sponsorIdField.value = '';
    sponsorExistingLogoField.value = '';
    document.getElementById('sponsor_order').value = nextSponsorOrder;
    sponsorSubmitBtn.textContent = 'Add Sponsor';
    sponsorCancelBtn.style.display = 'none';
  }

  sponsorCancelBtn.addEventListener('click', resetSponsorForm);

  async function uploadSponsorLogo(file) {
    const isPng = file.type === 'image/png';
    const outputType = isPng ? 'image/png' : 'image/jpeg';
    const resized = await resizeImageFile(file, 500, 0.85, outputType);
    const path = `${crypto.randomUUID()}.${isPng ? 'png' : 'jpg'}`;
    const { error } = await sb.storage.from('sponsor-logos').upload(path, resized, { contentType: outputType });
    if (error) throw error;
    const { data } = sb.storage.from('sponsor-logos').getPublicUrl(path);
    return data.publicUrl;
  }

  async function loadSponsorsAdminList() {
    const { data, error } = await sb
      .from('sponsors')
      .select('id, name, logo_url, details, notes, website, sort_order')
      .order('sort_order', { ascending: true });

    if (error) {
      sponsorsListEl.innerHTML = '<p class="form-status error">Could not load sponsors.</p>';
      return;
    }

    nextSponsorOrder = data.length ? Math.max(...data.map(x => x.sort_order || 0)) + 1 : 1;
    if (!sponsorIdField.value) document.getElementById('sponsor_order').value = nextSponsorOrder;

    const rows = data.map(s => `
      <tr data-id="${esc(s.id)}">
        <td>${esc(s.sort_order)}</td>
        <td>${s.logo_url ? `<img src="${esc(s.logo_url)}" alt="${esc(s.name)}" class="admin-sponsor-thumb">` : '—'}</td>
        <td>${esc(s.name)}</td>
        <td>
          <button type="button" class="sponsor-edit-btn">Edit</button>
          <button type="button" class="sponsor-delete-btn">Delete</button>
        </td>
      </tr>
    `).join('');

    sponsorsListEl.innerHTML = `
      <table class="member-table">
        <thead><tr><th>Order</th><th>Logo</th><th>Name</th><th>Actions</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    `;

    document.querySelectorAll('.sponsor-edit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.closest('tr').dataset.id;
        const s = data.find(x => x.id === id);
        sponsorIdField.value = s.id;
        sponsorExistingLogoField.value = s.logo_url || '';
        document.getElementById('sponsor_name').value = s.name || '';
        document.getElementById('sponsor_details').value = s.details || '';
        document.getElementById('sponsor_notes').value = s.notes || '';
        document.getElementById('sponsor_website').value = s.website || '';
        document.getElementById('sponsor_order').value = s.sort_order || nextSponsorOrder;
        sponsorSubmitBtn.textContent = 'Save Changes';
        sponsorCancelBtn.style.display = 'inline-block';
        window.scrollTo({ top: sponsorForm.offsetTop - 20, behavior: 'smooth' });
      });
    });

    document.querySelectorAll('.sponsor-delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.closest('tr').dataset.id;
        if (!confirm('Delete this sponsor?')) return;
        const { error } = await sb.from('sponsors').delete().eq('id', id);
        if (error) {
          alert('Could not delete: ' + error.message);
        } else {
          loadSponsorsAdminList();
        }
      });
    });
  }

  sponsorForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    sponsorSubmitBtn.disabled = true;
    sponsorStatusEl.className = 'form-status';
    sponsorStatusEl.textContent = 'Saving…';

    try {
      const logoFile = document.getElementById('sponsor_logo').files[0];
      const logo_url = logoFile ? await uploadSponsorLogo(logoFile) : sponsorExistingLogoField.value || null;

      const payload = {
        name: document.getElementById('sponsor_name').value.trim(),
        logo_url,
        details: document.getElementById('sponsor_details').value.trim() || null,
        notes: document.getElementById('sponsor_notes').value.trim() || null,
        website: document.getElementById('sponsor_website').value.trim() || null,
        sort_order: parseInt(document.getElementById('sponsor_order').value, 10) || nextSponsorOrder,
      };

      const id = sponsorIdField.value;
      const { error } = id
        ? await sb.from('sponsors').update(payload).eq('id', id)
        : await sb.from('sponsors').insert(payload);

      if (error) throw error;

      sponsorStatusEl.className = 'form-status success';
      sponsorStatusEl.textContent = id ? 'Sponsor updated.' : 'Sponsor added.';
      resetSponsorForm();
      loadSponsorsAdminList();
    } catch (err) {
      sponsorStatusEl.className = 'form-status error';
      sponsorStatusEl.textContent = 'Something went wrong: ' + err.message;
    } finally {
      sponsorSubmitBtn.disabled = false;
    }
  });

  (async () => {
    const gate = document.getElementById('admin-gate');
    const eventsSection = document.getElementById('admin-events-section');
    const sponsorsSection = document.getElementById('admin-sponsors-section');
    const charitySection = document.getElementById('admin-charity-section');
    const { data: { session } } = await sb.auth.getSession();

    if (!session) {
      gate.innerHTML = '<p>Please <a href="/login/?next=/admin/">log in</a> as an admin.</p>';
      return;
    }

    const { data: isAdmin, error: adminCheckError } = await sb.rpc('is_admin');

    if (adminCheckError || !isAdmin) {
      gate.innerHTML = '<p>Your account does not have admin access.</p>';
      return;
    }

    document.getElementById('member-search').style.display = 'block';
    document.getElementById('logout-bar').style.display = 'block';
    document.getElementById('logout-btn').addEventListener('click', async () => {
      await sb.auth.signOut({ scope: 'local' });
      window.location.href = '/login/';
    });
    loadAdminTable();
    eventsSection.style.display = 'block';
    loadEventsAdminList();
    charitySection.style.display = 'block';
    loadCharityAdminList();
    sponsorsSection.style.display = 'block';
    loadSponsorsAdminList();
  })();
</script>
