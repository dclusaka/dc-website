---
layout: layouts/base.njk
title: Events
---
<section class="page-simple page-wide">
  <h1>Events</h1>
  <div id="events-list">
    <p>Loading events…</p>
  </div>
</section>

<script>
  (async () => {
    const container = document.getElementById('events-list');
    const { data, error } = await sb
      .from('events')
      .select('title, event_date, time_label, location, description')
      .order('event_date', { ascending: false, nullsFirst: true });

    if (error) {
      container.innerHTML = '<p class="form-status error">Could not load events.</p>';
      return;
    }

    const today = new Date().toISOString().slice(0, 10);
    const upcoming = data.filter(e => !e.event_date || e.event_date >= today);
    const past = data.filter(e => e.event_date && e.event_date < today).sort((a, b) => b.event_date.localeCompare(a.event_date));

    function renderEvent(e, isPast) {
      const dateLabel = e.event_date
        ? new Date(e.event_date + 'T00:00:00').toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
        : 'Date TBD';
      return `
        <article class="event-card ${isPast ? 'event-card-past' : ''}">
          <h3>${e.title}</h3>
          <p class="event-meta">${dateLabel}${e.time_label ? ', ' + e.time_label : ''} · ${e.location || ''}</p>
          ${e.description ? `<p class="event-note">${e.description}</p>` : ''}
        </article>
      `;
    }

    container.innerHTML = `
      <h2>Upcoming</h2>
      <div class="event-list">
        ${upcoming.length ? upcoming.map(e => renderEvent(e, false)).join('') : '<p>No upcoming events right now.</p>'}
      </div>
      <h2>Past Events</h2>
      <div class="event-list">
        ${past.map(e => renderEvent(e, true)).join('')}
      </div>
    `;
  })();
</script>
