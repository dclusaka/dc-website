---
layout: layouts/base.njk
---
<section class="page-simple">
  <p class="event-detail-meta">{{ date_label }}{% if time_label %}, {{ time_label }}{% endif %}</p>
  <h1>{{ title }}</h1>
  <p class="event-detail-location">{{ location }}</p>

  <div class="event-detail-body">
    {{ content | safe }}
  </div>

  <a class="text-link" href="/events/">← Back to all events</a>
</section>
