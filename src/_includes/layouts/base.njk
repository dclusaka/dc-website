<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} — Diplomatic Club of Lusaka</title>
  <meta name="description" content="{{ description or 'A non-profit international community in Lusaka, Zambia, connecting diplomats and friends of Zambia while raising funds for local causes.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/@supabase/supabase-js@2"></script>
  <script src="/js/supabase-client.js"></script>
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">
      <img class="wordmark-icon" src="/images/logo-icon.png" alt="Diplomatic Club of Lusaka logo">
      <span class="wordmark-full">Diplomatic Club of Lusaka</span>
    </a>
    <nav class="site-nav">
      <a href="/events/">Events</a>
      <a href="/benefits/">Benefits</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/members/" class="nav-members">Member Login</a>
      <a href="/apply/" class="nav-apply">Apply</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>© 2026 Diplomatic Club of Lusaka</p>
    <a href="/admin/" class="footer-admin-link">Admin</a>
  </footer>
</body>
</html>
