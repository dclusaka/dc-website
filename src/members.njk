---
layout: layouts/base.njk
title: Member Login
---
<style>
  #members-gate .member-card {
    background: #331648; color: #FBF8FC; border: 1px solid #4A2E5C; border-radius: 12px;
    padding: 1.5rem; max-width: 26rem; display: flex; flex-wrap: wrap;
    gap: 1.25rem 1.5rem; align-items: flex-start; box-shadow: 0 6px 18px rgba(51, 22, 72, 0.25);
  }
  #members-gate .member-card-club {
    flex-basis: 100%; color: #C9A66B; font-size: 0.75rem; letter-spacing: 0.14em;
    text-transform: uppercase; font-weight: 600;
    border-bottom: 1px solid rgba(201, 166, 107, 0.4); padding-bottom: 0.6rem;
  }
  #members-gate .member-card-photo {
    width: 6rem; height: auto; aspect-ratio: 4 / 5; border-radius: 4px; object-fit: cover;
    border: 2px solid #C9A66B; flex-shrink: 0;
  }
  #members-gate .member-card-name { color: #FBF8FC; }
  #members-gate .card-status-active { color: #C9A66B; }
  #members-gate .card-status-inactive { color: #FFB4A8; }
  #members-gate .member-card-expiry,
  #members-gate .member-card-hint { color: #D9CCE3; }
  #members-gate .member-card-qr { background: #FFFFFF; padding: 8px; border-radius: 6px; width: 150px; height: 150px; }
</style>
<div id="logout-bar" style="display:none;text-align:right;padding:1rem clamp(1.25rem, 4vw, 3rem) 0;">
  <a id="admin-link" href="/admin/" style="display:none;margin-right:1rem;font-size:0.9rem;color:#331648;">Admin panel</a>
  <button type="button" id="logout-btn" style="cursor:pointer;font-family:inherit;font-size:0.9rem;padding:0.5rem 1.1rem;background:none;color:#331648;border:1px solid #331648;">Log out</button>
</div>
<section class="page-simple page-wide">
  <h1>Member Login</h1>
  <div id="members-gate">
    <p>Checking your login…</p>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
  function esc(v) {
    return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  async function loadOwnCard(session) {
    const { data, error } = await sb
      .from('members')
      .select('first_name, surname, photo_url, status, membership_expires, verify_token')
      .eq('auth_user_id', session.user.id)
      .single();

    if (error || !data) {
      return '<p class="form-status error">Could not load your card.</p>';
    }

    const fullName = data.first_name + ' ' + data.surname;
    const verifyUrl = window.location.origin + '/verify/?token=' + data.verify_token;
    const qrImg = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(verifyUrl);
    const statusLabel = data.status === 'active' ? '✓ Active Member' : data.status.charAt(0).toUpperCase() + data.status.slice(1);
    const statusClass = data.status === 'active' ? 'card-status-active' : 'card-status-inactive';

    return `
      <div class="member-card" id="member-card-capture">
        <div class="member-card-club">Diplomatic Club of Lusaka</div>
        ${data.photo_url
          ? `<img class="member-card-photo" src="${esc(data.photo_url)}" crossorigin="anonymous" alt="${esc(fullName)}">`
          : `<div class="member-card-photo" style="display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.12);color:#C9A66B;font-size:1.6rem;font-weight:600;">${esc((data.first_name || '').charAt(0) + (data.surname || '').charAt(0))}</div>`}
        <div class="member-card-body">
          <p class="member-card-name">${esc(fullName)}</p>
          <p class="${statusClass}">${statusLabel}</p>
          ${data.membership_expires ? `<p class="member-card-expiry">Valid until ${data.membership_expires}</p>` : ''}
          <img class="member-card-qr" src="${qrImg}" crossorigin="anonymous" alt="Verification QR code">
          <p class="member-card-hint">Show this page or QR code to receive member discounts.</p>
        </div>
      </div>
      <button type="button" id="save-card-btn" class="button-primary" style="margin-top:1rem;">Save Card as Image</button>
      <p class="form-status" id="save-card-status"></p>
    `;
  }

  async function loadDirectory() {
    const { data, error } = await sb.rpc('member_directory');

    if (error) {
      return '<p class="form-status error">Could not load the directory: ' + esc(error.message) + '</p>';
    }

    if (!data || data.length === 0) {
      return '<p>The directory will appear once your membership is active.</p>';
    }

    const rows = data.map(m => `
      <tr>
        <td>${esc(m.full_name)}</td>
        <td>${esc(m.diplomatic_mission)}</td>
        <td>${m.email ? `<a href="mailto:${esc(m.email)}">${esc(m.email)}</a>` : ''}</td>
        <td>${m.phone ? `<a href="tel:${esc(String(m.phone).replace(/\s+/g, ''))}">${esc(m.phone)}</a>` : ''}</td>
      </tr>
    `).join('');

    return `
      <table class="member-table">
        <thead><tr><th>Name</th><th>Mission</th><th>Email</th><th>Phone</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    `;
  }

  (async () => {
    const gate = document.getElementById('members-gate');
    const { data: { session } } = await sb.auth.getSession();

    if (!session) {
      gate.innerHTML = '<p>Please <a href="/login/">log in</a> to see your membership card and the member directory.</p>';
      return;
    }

    document.getElementById('logout-bar').style.display = 'block';
    document.getElementById('logout-btn').addEventListener('click', async () => {
      await sb.auth.signOut({ scope: 'local' });
      window.location.href = '/login/';
    });

    sb.rpc('is_admin').then(({ data: isAdmin }) => {
      if (isAdmin) document.getElementById('admin-link').style.display = 'inline';
    });

    const [cardHtml, directoryHtml] = await Promise.all([
      loadOwnCard(session),
      loadDirectory(),
    ]);

    gate.innerHTML = `
      <h2>My Card</h2>
      ${cardHtml}
      <h2>Current Members</h2>
      ${directoryHtml}
    `;

    const saveBtn = document.getElementById('save-card-btn');
    if (saveBtn) {
      saveBtn.addEventListener('click', async () => {
        const statusEl = document.getElementById('save-card-status');
        saveBtn.disabled = true;
        statusEl.textContent = 'Preparing image…';

        try {
          const cardEl = document.getElementById('member-card-capture');
          const canvas = await html2canvas(cardEl, { useCORS: true, backgroundColor: null, scale: 2 });
          const link = document.createElement('a');
          link.download = 'membership-card.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
          statusEl.textContent = '';
        } catch (err) {
          statusEl.className = 'form-status error';
          statusEl.textContent = 'Could not save image: ' + err.message;
        } finally {
          saveBtn.disabled = false;
        }
      });
    }
  })();
</script>
