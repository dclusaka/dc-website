---
layout: layouts/base.njk
title: Current Members
---
<section class="page-simple page-wide">
  <h1>Current Members</h1>
  <div id="members-gate">
    <p>Checking your login…</p>
  </div>
</section>

<script>
  (async () => {
    const gate = document.getElementById('members-gate');
    const { data: { session } } = await sb.auth.getSession();

    if (!session) {
      gate.innerHTML = '<p>Please <a href="/login/">log in</a> to see the member directory.</p>';
      return;
    }

    const { data, error } = await sb.rpc('member_directory');

    if (error) {
      gate.innerHTML = '<p class="form-status error">Could not load the directory: ' + error.message + '</p>';
      return;
    }

    if (!data || data.length === 0) {
      gate.innerHTML = '<p>The directory will appear once your membership is active.</p>';
      return;
    }

    const rows = data.map(m =>
      `<tr><td>${m.full_name}</td></tr>`
    ).join('');

    gate.innerHTML = `
      <table class="member-table">
        <thead><tr><th>Name</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    `;
  })();
</script>
