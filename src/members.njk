---
layout: layouts/base.njk
title: Member Login
---
<section class="page-simple page-wide">
  <h1>Member Login</h1>
  <div id="members-gate">
    <p>Checking your login…</p>
  </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
  async function loadOwnCard(session) {
    const { data, error } = await sb
      .from('members')
      .select('first_name, surname, photo_url, status, membership_expires, verify_token')
      .eq('auth_user_id', session.user.id)
      .single();

    if (error || !data) {
      return '<p class="form-status error">Could not load your card.</p>';
    }

    const fullName = data.first_name + ' ' + data.surname;
    const verifyUrl = window.location.origin + '/verify/?token=' + data.verify_token;
    const qrImg = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(verifyUrl);
    const statusLabel = data.status === 'active' ? '✓ Active Member' : data.status.charAt(0).toUpperCase() + data.status.slice(1);
    const statusClass = data.status === 'active' ? 'card-status-active' : 'card-status-inactive';

    return `
      <div class="member-card" id="member-card-capture">
        <img class="member-card-photo" src="${data.photo_url}" crossorigin="anonymous" alt="${fullName}">
        <div class="member-card-body">
          <p class="member-card-name">${fullName}</p>
          <p class="${statusClass}">${statusLabel}</p>
          ${data.membership_expires ? `<p class="member-card-expiry">Valid until ${data.membership_expires}</p>` : ''}
          <img class="member-card-qr" src="${qrImg}" crossorigin="anonymous" alt="Verification QR code">
          <p class="member-card-hint">Show this page or QR code to receive member discounts.</p>
        </div>
      </div>
      <button type="button" id="save-card-btn" class="button-primary" style="margin-top:1rem;">Save Card as Image</button>
      <p class="form-status" id="save-card-status"></p>
    `;
  }

  async function loadDirectory() {
    const { data, error } = await sb.rpc('member_directory');

    if (error) {
      return '<p class="form-status error">Could not load the directory: ' + error.message + '</p>';
    }

    if (!data || data.length === 0) {
      return '<p>The directory will appear once your membership is active.</p>';
    }

    const rows = data.map(m => `<tr><td>${m.full_name}</td></tr>`).join('');

    return `
      <table class="member-table">
        <thead><tr><th>Name</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    `;
  }

  (async () => {
    const gate = document.getElementById('members-gate');
    const { data: { session } } = await sb.auth.getSession();

    if (!session) {
      gate.innerHTML = '<p>Please <a href="/login/">log in</a> to see your membership card and the member directory.</p>';
      return;
    }

    const [cardHtml, directoryHtml] = await Promise.all([
      loadOwnCard(session),
      loadDirectory(),
    ]);

    gate.innerHTML = `
      <h2>My Card</h2>
      ${cardHtml}
      <h2>Current Members</h2>
      ${directoryHtml}
    `;

    const saveBtn = document.getElementById('save-card-btn');
    if (saveBtn) {
      saveBtn.addEventListener('click', async () => {
        const statusEl = document.getElementById('save-card-status');
        saveBtn.disabled = true;
        statusEl.textContent = 'Preparing image…';

        try {
          const cardEl = document.getElementById('member-card-capture');
          const canvas = await html2canvas(cardEl, { useCORS: true, backgroundColor: '#FBF8FC', scale: 2 });
          const link = document.createElement('a');
          link.download = 'membership-card.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
          statusEl.textContent = '';
        } catch (err) {
          statusEl.className = 'form-status error';
          statusEl.textContent = 'Could not save image: ' + err.message;
        } finally {
          saveBtn.disabled = false;
        }
      });
    }
  })();
</script>
