---
layout: layouts/base.njk
title: Events
permalink: /events/
---
<section class="page-simple page-wide">
  <h1>Events</h1>

  <h2>Upcoming</h2>
  <div class="event-list">
    {% for e in collections.events %}
    {% if e.data.upcoming %}
    <article class="event-card">
      <h3><a href="{{ e.url }}">{{ e.data.title }}</a></h3>
      <p class="event-meta">{{ e.data.date_label }}{% if e.data.time_label %}, {{ e.data.time_label }}{% endif %} · {{ e.data.location }}</p>
      <a class="text-link" href="{{ e.url }}">Details →</a>
    </article>
    {% endif %}
    {% endfor %}
  </div>

  <h2>Past Events</h2>
  <div class="event-list">
    {% for e in collections.events %}
    {% if not e.data.upcoming %}
    <article class="event-card event-card-past">
      <h3><a href="{{ e.url }}">{{ e.data.title }}</a></h3>
      <p class="event-meta">{{ e.data.date_label }}{% if e.data.time_label %}, {{ e.data.time_label }}{% endif %} · {{ e.data.location }}</p>
      <a class="text-link" href="{{ e.url }}">Details →</a>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>
